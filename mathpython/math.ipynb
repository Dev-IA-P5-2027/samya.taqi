    "x = symbols('x')\n",
    "expr = x**2 + 3*x + 2\n",
    " \n",
    "# Calcul de la dérivée de l'expression par rapport à x\n",
    "derivative_expr = Derivative(expr, x)\n",
    " \n",
    "# Affichage de la dérivée\n",
    "print(derivative_expr)"
