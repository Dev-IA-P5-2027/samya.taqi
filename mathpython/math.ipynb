    "def multiplication(matrice_A, matrice_B):\n",
    "    matrice=[]\n",
    "    n= matrice_A.shape[0]\n",
    "    q=matrice_B.shape[1]\n",
    "    p=matrice_A.shape[1]\n",
    "    for ligne in range(1,n):\n",
    "        X=[]\n",
    "        for colonne in range (1,q):\n",
    "            v=0\n",
    "            \n",
    "            for k in range(1,p):\n",
    "                \n",
    "                \n",
    "                v+=int(matrice_A[ligne,k] * matrice_B[ k,colonne])\n",
    "            X.append(v)\n",
    "           \n",
    "        matrice.append(X)    \n",
    "    return matrice\n"
   ]
