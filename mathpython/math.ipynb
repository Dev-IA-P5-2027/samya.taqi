    "def palindrome(mot):\n",
    "    if len(mot) <=1:\n",
    "        return True\n",
    "    else:\n",
    "        if mot[0]!= mot[-1]:\n",
    "            return False\n",
    "        else: \n",
    "            return palindrome(mot[1:-1])\n",
    "palindrome(\"sos\")\n"
   ]
