    "def r(x,deb,fin,L): # on cherche un élément x dans la liste L\n",
    "    if deb>fin:\n",
    "        return \"vous êtes pas dans la liste\"\n",
    "    t=(deb+fin)//2 # on divise la liste en deux \n",
    "    print(t)\n",
    "    if x == L[t]:\n",
    "        return t\n",
    "    elif x < L[t]:\n",
    "        return r(x, deb, t - 1, L)\n",
    "    else:\n",
    "        return r(x, t + 1, fin, L)\n",
    "\n",
    "L = [2, 3, 4, 7, 11, 15, 17]\n",
    "# print(len(L))\n",
    "print(r(17, 0, len(L) - 1, L))\n"
   ]
