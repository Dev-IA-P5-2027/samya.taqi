    "import random\n",
    "def matrice_aleatoire(n,p):\n",
    "    matrice=[]\n",
    "    for i in range(n):\n",
    "        ligne=[]\n",
    "        for j in range(p):\n",
    "            ligne.append(random.randint(1, 9))\n",
    "        matrice.append(ligne)\n",
    "    return matrice            \n",
    "            \n",
    "print(matrice_aleatoire(5,6))\n",
    "import random\n",
    "\n",
    "def somme_matrice(n, p):\n",
    "    matrice_A = []\n",
    "    matrice_B = []\n",
    "    matrice_C = []\n",
    "    \n",
    "    # Génération des matrices A et B\n",
    "    for i in range(n):\n",
    "        ligne_A = []\n",
    "        ligne_B = []\n",
    "        \n",
    "        for j in range(p):\n",
    "            ligne_A.append(random.randint(1, 9))\n",
    "            ligne_B.append(random.randint(1, 9))\n",
    "        \n",
    "        matrice_A.append(ligne_A)\n",
    "        matrice_B.append(ligne_B)\n",
    "    \n",
    "    # Calcul de la somme\n",
    "    for i in range(n):\n",
    "        ligne_C = []\n",
    "        for j in range(p):\n",
    "            ligne_C.append(matrice_A[i][j] + matrice_B[i][j])\n",
    "        matrice_C.append(ligne_C)\n",
    "\n",
    "    print(\"Matrice A :\", matrice_A)\n",
    "    print(\"Matrice B :\\n\", matrice_B)\n",
    "    \n",
    "    return matrice_C\n",
    "\n",
    "\n",
    "print(\"Matrice C (Somme) :\", somme_matrice(5, 6))"
