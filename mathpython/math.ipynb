    "            {\"name\": \"Alex\", \"salary\": 1800}\n",
    "            ],\n",
    "        \"sites etrangers\": [\n",
    "            {\"name\": \"samya\", \"salary\":5000}\n",
    "        ],\n",
    "        \n",
    "        \"internals\": [\n",
    "            {\"name\": \"Jack\", \"salary\": 1300}\n",
    "        ]\n",
    "    }\n",
    "}\n",
    "\n",
    "def sum_salaries(department):\n",
    "    # Cas 1 : si c'est une liste (équivalent Array.isArray)\n",
    "    if isinstance(department, list): #fonction return True if the specified object is of the specified type , othewise fALSE\n",
    "        return sum(person[\"salary\"] for person in department)\n",
    "    else:\n",
    "        # Cas 2 : si c'est un dictionnaire\n",
    "        total = 0\n",
    "        for subdep in department.values():\n",
    "            total += sum_salaries(subdep)  # appel récursif\n",
    "        return total\n",
    "\n",
    "print(sum_salaries(company))  # 7700"
   ]
